            "outline": "BottomOnly",
            "outlineColor": {
              "solid": {
                "color": "#3B9EFF"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#EAF2FF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E1E42"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#EAF2FF"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#0E1E42"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#EAF2FF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0E1E42"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FF7A6B"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E1E42"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "lineStackedColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "funnel": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#3B9EFF"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#C4D5F2"
              }
            },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
