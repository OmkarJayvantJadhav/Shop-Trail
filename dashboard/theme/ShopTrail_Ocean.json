        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9DB4DE"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#9DB4DE"
              }
            },
            "lineColor": {
              "solid": {
                "color": "#1F3A70"
              }
            },
            "gridlineShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#172B58"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#9DB4DE"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#9DB4DE"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#172B58"
              }
            },
            "gridlineShow": true
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#C4D5F2"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#EAF2FF"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#07122B"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#07122B"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#9DB4DE"
              }
            },
            "textSize": 11
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#EAF2FF"
              }
            },
            "background": {
              "solid": {
                "color": "#0A1733"
              }
            },
            "textSize": 11
          }
        ],
        "slider": [
          {
            "color": {
              "solid": {
                "color": "#3B9EFF"
              }
            }
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#EAF2FF"
              }
            },
            "background": {
              "solid": {
                "color": "#0A1733"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
