{
  "name": "ShopTrail Ocean",
  "dataColors": [
    "#3B9EFF",
    "#FF7A6B",
    "#7C8CFF",
    "#FFB36B",
    "#43D9C5",
    "#FF6FA5",
    "#B7E36B",
    "#8FA3C7"
  ],
  "background": "#0E1E42",
  "foreground": "#EAF2FF",
  "tableAccent": "#3B9EFF",
  "good": "#3B9EFF",
  "neutral": "#FF7A6B",
  "bad": "#FF6FA5",
  "maximum": "#3B9EFF",
  "center": "#FF7A6B",
  "minimum": "#FF6FA5",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#9DB4DE"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#FFFFFF"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#EAF2FF"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#EAF2FF"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0E1E42"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F3A70"
              }
            },
            "radius": 16
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
