{
  "name": "ShopTrail Google",
  "dataColors": [
    "#4285F4",
    "#EA4335",
    "#34A853",
    "#FBBC04",
    "#46BDC6",
    "#AB47BC",
    "#FF7043",
    "#9AA0A6"
  ],
  "background": "#FFFFFF",
  "foreground": "#202124",
  "tableAccent": "#4285F4",
  "good": "#34A853",
  "neutral": "#FBBC04",
  "bad": "#EA4335",
  "maximum": "#34A853",
  "center": "#FBBC04",
  "minimum": "#EA4335",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#5F6368"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#202124"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#202124"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#202124"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DADCE0"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#202124"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "lineColor": {
              "solid": {
                "color": "#DADCE0"
              }
            },
            "gridlineShow": false,
            "gridlineColor": {
              "solid": {
                "color": "#E8EAED"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#E8EAED"
              }
            },
            "gridlineShow": true
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#202124"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#202124"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F1F3F4"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F1F3F4"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "textSize": 11
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#202124"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 11
          }
        ],
        "slider": [
          {
            "color": {
              "solid": {
                "color": "#4285F4"
              }
            }
          }
        ],
        "date": [
          {
            "fontColor": {
              "solid": {
                "color": "#202124"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E8EAED"
              }
            },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1A73E8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outline": "BottomOnly",
            "outlineColor": {
              "solid": {
                "color": "#4285F4"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#202124"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#202124"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#202124"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#202124"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "lineStackedColumnComboChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3,
            "showMarker": false
          }
        ]
      }
    },
    "funnel": {
      "*": {
        "dataPoint": [
          {
            "defaultColor": {
              "solid": {
                "color": "#4285F4"
              }
            }
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5F6368"
              }
            },
            "fontSize": 11
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#202124"
              }
            }
          }
        ]
      }
    }
  }
}